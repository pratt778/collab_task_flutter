# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets — never commit these
.env
.env.local
.env.*.local

# Android signing — committing the keystore lets anyone sign a build as you
*.keystore
*.jks
key.properties
android/app/upload-keystore.jks
android/key.properties

# Xcode per-user state
ios/Runner.xcodeproj/xcuserdata/
ios/Runner.xcworkspace/xcuserdata/
ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/

# Firebase configs — uncomment if your team treats these as private.
# Firebase API keys are app identifiers, not secrets, but the files include
# OAuth client IDs and bundle/package mappings some teams prefer to keep out
# of public repos. Most teams commit them; flip these on if yours doesn't.
# lib/firebase_options.dart
# **/google-services.json
# **/GoogleService-Info.plist
.aider*
