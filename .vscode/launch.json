  "version": "0.2.0",
  "configurations": [
    {
      "name": "Irrigation (Development)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_development.dart",
      "flutterMode": "debug",
      "args": ["--flavor", "development"]
    },
    {
      "name": "Irrigation (Staging)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_staging.dart",
      "flutterMode": "profile",
      "args": ["--flavor", "staging"]
    },
    {
      "name": "Irrigation (Production)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_production.dart",
      "flutterMode": "release",
      "args": ["--flavor", "production"]
    },
    {
      "name": "irrigation_flutter",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "irrigation_flutter (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "irrigation_flutter (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    }
  ]
}
